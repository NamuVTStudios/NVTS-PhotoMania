    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@nvts/app-object": "link:../NVTS-Shared-Core/packages/app-object",
    "@nvts/shared-core": "link:../NVTS-Shared-Core"
  }
