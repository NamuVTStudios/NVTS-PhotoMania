{
  "name": "nvts-photomania",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build:wasm": "cd packages/engine && bash build.sh && cd ../.. && node tools/copy-wasm.mjs",
    "dev": "pnpm --filter @nvts/web dev",
    "build": "pnpm --filter @nvts/web build",
    "preview": "pnpm --filter @nvts/web preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "audit:control-flow": "node tools/audit-control-flow.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@webgpu/types": "^0.1.40",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
