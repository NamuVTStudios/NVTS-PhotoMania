{
  "name": "nvts-photomania",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build:wasm": "node tools/build-wasm.mjs",
    "dev": "node tools/build-wasm.mjs && node tools/run-vite.mjs dev",
    "build": "node tools/build-wasm.mjs && node tools/run-vite.mjs build",
    "preview": "node tools/run-vite.mjs preview",
    "typecheck": "tsc -p tsconfig.json",
