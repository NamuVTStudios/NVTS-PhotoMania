{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types",
      "wicg-file-system-access",
      "vite/client",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@nvts/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@nvts/wasm-bindings": [
        "./packages/wasm-bindings/index.ts"
      ],
      "@nvts/renderer": [
        "./packages/renderer/index.ts"
      ],
      "@nvts/document-model": [
        "./packages/document-model/src/index.ts"
      ],
      "@nvts/storage": [
        "./packages/storage/src/index.ts"
      ],
      "@nvts/templates": [
        "./packages/templates/src/index.ts"
      ],
      "@nvts/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@nvts/image-processing": [
        "./packages/image-processing/src/index.ts"
      ],
      "@nvts/vector": [
        "./packages/vector/src/index.ts"
      ],
      "@nvts/app-object": [
        "../NVTS-Shared-Core/packages/app-object/src/index.ts"
      ],
      "@nvts/shared-core/*": [
        "../NVTS-Shared-Core/*"
      ],
      "@nvts/shared-core/libraries/pixijs": [
        "../NVTS-Shared-Core/libraries/rendering/pixijs/index.d.ts"
      ],
      "@nvts/shared-core/libraries/rendering/pixijs": [
        "../NVTS-Shared-Core/libraries/rendering/pixijs/index.d.ts"
      ],
      "@nvts/shared-core/libraries/canvaskit": [
        "../NVTS-Shared-Core/libraries/rendering/canvaskit/index.d.ts"
      ],
      "@nvts/shared-core/libraries/opencolorio": [
        "../NVTS-Shared-Core/libraries/imaging/opencolorio/index.d.ts"
      ],
      "@nvts/shared-core/libraries/openimageio": [
        "../NVTS-Shared-Core/libraries/imaging/openimageio/index.d.ts"
      ],
      "@nvts/shared-core/libraries/rendering/canvaskit": [
        "../NVTS-Shared-Core/libraries/rendering/canvaskit/index.d.ts"
      ],
      "@nvts/shared-core/libraries/imaging/openimageio": [
        "../NVTS-Shared-Core/libraries/imaging/openimageio/index.d.ts"
      ],
      "@nvts/shared-core/libraries/imaging/opencolorio": [
        "../NVTS-Shared-Core/libraries/imaging/opencolorio/index.d.ts"
      ],
      "@nvts/shared-core/templates": [
        "../NVTS-Shared-Core/packages/templates/src/index.d.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "packages/wasm-bindings/build"
  ]
}
