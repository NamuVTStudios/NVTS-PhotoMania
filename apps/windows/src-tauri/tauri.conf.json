{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "NVTS-PhotoMania",
    "version": "0.1.0",
    "identifier": "com.namuvt.nvts.photomania.windows",
    "build": {
        "beforeDevCommand": "pnpm --dir ../.. dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "pnpm --dir ../.. build",
        "frontendDist": "../../web/dist"
    },
    "app": {
        "windows": [
            {
                "title": "NVTS-PhotoMania",
                "width": 1280,
                "height": 820,
                "minWidth": 900,
                "minHeight": 600
            }
        ],
        "security": {
            "csp": null
        },
        "withGlobalTauri": true
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "fileAssociations": [
            {
                "ext": [
                    "nvtsphoto"
                ],
                "name": "NVTS-PhotoMania.nvtsphoto",
                "description": "Proyecto NVTS PhotoMania (.nvtsphoto)",
                "mimeType": "application/x-nvtsphoto",
                "role": "Editor",
                "rank": "Owner",
                "exportedType": {
                    "identifier": "com.namuvt.nvts.photomania.project",
                    "conformsTo": [
                        "public.data"
                    ]
                }
            }
        ],
        "resources": {
            "../../web/public/branding/file-types/nvtsphoto-pmd.ico": "nvtsphoto-pmd.ico",
            "../../web/public/branding/file-types/nvtsphoto-pmd.png": "nvtsphoto-pmd.png"
        },
        "windows": {
            "nsis": {
                "installerHooks": "filetype-icon.nsh"
            },
            "wix": {
                "fragmentPaths": [
                    "filetype-icon.wxs"
                ],
                "componentRefs": [
                    "NVTSPhotoTypeIconRegistry"
                ]
            }
        }
    }
}
